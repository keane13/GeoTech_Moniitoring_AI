{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .cortex/hooks/validate-geotech-pipeline.sh",
            "timeout": 30,
            "enabled": true,
            "statusMessage": "Validating pipeline order..."
          }
        ]
      }
    ]
  }
}